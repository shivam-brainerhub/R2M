# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# --- Application & Frontend ---
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=r2m
# For Docker internal communication use db:5432, for localhost use localhost:5432
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@db:5432/r2m

# --- Authentication & JWT Security ---
# Secret key used for signing JWT tokens (generate using `openssl rand -hex 32`)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Initial Admin Bootstrap Credentials ---
# Automatically seeded on first startup if no admin user exists
INITIAL_ADMIN_EMAIL=admin@r2m.co.za
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeThisAdminPassword123!
